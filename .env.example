# Скопируйте в .env и замените все change-me значения.
# .env в Git не коммитится.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=navoke.relaxdev.ru,www.navoke.relaxdev.ru
SITE_URL=https://navoke.relaxdev.ru

# PostgreSQL
POSTGRES_DB=navoke_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
# Пароль в URL должен быть percent-encoded, если содержит @ : / % и т.п.
DATABASE_URL=postgresql://postgres:change-me-strong-db-password@db:5432/navoke_db

# Redis
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379/1
CELERY_BROKER_URL=redis://:change-me-strong-redis-password@redis:6379/0

# ЮKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key
YOOKASSA_RETURN_URL=https://navoke.relaxdev.ru/order-success/
# True только за доверенным reverse-proxy (Nginx перезаписывает X-Real-IP).
YOOKASSA_TRUST_PROXY=True
# YOOKASSA_TRUSTED_NETS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.154.128/25,77.75.156.11/32,77.75.156.35/32

# Firebase: base64 от JSON service account
FIREBASE_CREDENTIALS=base64-encoded-service-account-json

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=noreply@navoke.relaxdev.ru
EMAIL_HOST_PASSWORD=change-me-app-password
DEFAULT_FROM_EMAIL=noreply@navoke.relaxdev.ru
ADMIN_EMAIL=admin@navoke.relaxdev.ru
EMAIL_TIMEOUT=10

# Для порта 587:
# EMAIL_PORT=587
# EMAIL_USE_SSL=False
# EMAIL_USE_TLS=True

# Уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
